{
  "name": "guysfall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --experimental-strip-types --test",
    "trial": "node --env-file-if-exists=.env src/trial.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "sim": "node src/sim.mjs",
    "sim:builds": "node src/build-sim.mjs",
    "art": "node scripts/build-atlas.mjs",
    "art:check": "node scripts/check-art.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
